# ══════════════════════════════════════════════════════════════════
#  .gitignore — RAÍZ del proyecto LibreriaAmateur
#  Cubre frontend (royal-road-hispano) y backend (server)
# ══════════════════════════════════════════════════════════════════

# ── SECRETOS Y CONFIGURACIÓN (lo más importante) ──
.env
.env.local
.env.production
.env.*.local
royal-road-hispano/.env
server/.env

# ── BASE DE DATOS (datos, no código) ──
# Incluye los archivos del modo WAL de SQLite
*.db
*.db-wal
*.db-shm
server/database.db
server/database.db-wal
server/database.db-shm
royal-road-hispano/database.db

# ── IMÁGENES SUBIDAS POR USUARIOS ──
# Ignorar las imágenes subidas por usuarios, PERO conservar la portada
# por defecto (default_cover.jpeg) que es parte del proyecto.
server/static/covers/*
!server/static/covers/default_cover.jpeg
server/static/avatars_uploaded/

# ── PYTHON (backend) ──
__pycache__/
*.py[cod]
*.egg-info/
server/venv/
server/env/
venv/
env/

# ── NODE / FRONTEND ──
node_modules/
royal-road-hispano/node_modules/
royal-road-hispano/dist/
royal-road-hispano/dist-ssr/
dist/
*.local

# ── LOGS ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── EDITORES / SISTEMA OPERATIVO ──
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── ARCHIVOS TEMPORALES / BASURA ──
cosasModificar.txt
*_Inutil.py
check_wal.py
diagnostico_fechas.py